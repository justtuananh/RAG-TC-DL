# Mọi biến ở đây override config/settings.yaml; không đặt thì dùng mặc định trong file đó.
# .env.example — Sao chép thành .env và điều chỉnh nếu cần
# Hầu hết không cần sửa khi chạy toàn bộ stack trong Docker.

# ── LLM Configuration ──────────────────────────────────────────────────────
# Model chat; để trống thì dùng models.llm_chat của config/settings.yaml.
# OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Database Configuration ────────────────────────────────────────────────
# PostgreSQL connection (Docker: uses service name 'postgres')
POSTGRES_DB=qtkd
POSTGRES_USER=qtkd_user
POSTGRES_PASSWORD=qtkd_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional: Override with full DATABASE_URL instead of individual vars
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Authentication ────────────────────────────────────────────────────────
# Bật đăng nhập (true) hoặc tắt (false: mọi người dùng là quản trị viên cục bộ, không cần đăng nhập)
AUTH_ENABLED=false

# JWT secret key. Để trống khi dev: mỗi tiến trình sinh khóa tạm (token mất khi khởi động lại).
# Production (APP_ENV=production) bắt buộc đặt, ít nhất 32 byte, ví dụ sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# JWT token expiration in hours
JWT_EXPIRATION_HOURS=24

# ── macOS: Ollama chạy native (brew install ollama + ollama serve) ──────────
# Override API endpoint; the full Compose model services currently require NVIDIA.
# For a non-NVIDIA host, configure model services separately.
# OLLAMA_URL=http://host.docker.internal:11434/v1/chat/completions

# ── Nếu muốn dùng model lớn hơn trên prod ──────────────────────────────────
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Thư mục SQLite công thức trên máy chủ Docker (bind mount vào api).
FORMULA_REGISTRY_DIR=./.formula-registry
# Chạy Python cục bộ: đường dẫn SQLite tuỳ chọn (Docker dùng /app/.formula-registry).
# FORMULA_REGISTRY_DB=/absolute/path/registry.sqlite3
