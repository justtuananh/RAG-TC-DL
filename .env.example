# .env.example — Sao chép thành .env và điều chỉnh nếu cần
# Hầu hết không cần sửa khi chạy toàn bộ stack trong Docker.

# ── LLM Configuration ──────────────────────────────────────────────────────
# LLM model (qwen2.5:1.5b cho dev, qwen2.5:7b cho prod)
OLLAMA_MODEL=qwen2.5:1.5b

# ── Sprint 5: trích xuất §6 bằng LLM ───────────────────────────────────────
# Mặc định TẮT để ingestion không phụ thuộc Ollama. Bật để chạy §6 sau bước nhúng.
# SECTION6_LLM_ENABLED=true
# Model riêng cho trích xuất (mặc định lấy OLLAMA_MODEL, fallback qwen2.5:7b)
# SECTION6_LLM_MODEL=qwen2.5:7b
# URL Ollama native/OpenAI-compat (mặc định lấy OLLAMA_URL)
# SECTION6_OLLAMA_URL=http://ollama:11434/v1/chat/completions
# SECTION6_LLM_TIMEOUT=120
# SECTION6_LLM_NUM_CTX=8192
# SECTION6_LLM_TEMPERATURE=0.0

# ── Sprint 9: chat lai văn bản + số liệu ───────────────────────────────────
# Bật/tắt định tuyến nhánh số liệu (mặc định bật). Tắt → mọi câu hỏi đi RAG văn bản.
# INTENT_ROUTER_ENABLED=true
# Model/URL cho bộ phân loại intent (mặc định lấy OLLAMA_MODEL/OLLAMA_URL)
# INTENT_LLM_MODEL=qwen2.5:1.5b
# INTENT_OLLAMA_URL=http://ollama:11434/v1/chat/completions
# INTENT_LLM_TIMEOUT=60
# INTENT_LLM_NUM_CTX=4096
# INTENT_LLM_TEMPERATURE=0.0

# ── Database Configuration ────────────────────────────────────────────────
# PostgreSQL connection (Docker: uses service name 'postgres')
POSTGRES_DB=qtkd
POSTGRES_USER=qtkd_user
POSTGRES_PASSWORD=qtkd_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional: Override with full DATABASE_URL instead of individual vars
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Authentication ────────────────────────────────────────────────────────
# Enable/disable authentication (set to 'false' for dev without auth)
AUTH_ENABLED=true

# JWT secret key (CHANGE THIS IN PRODUCTION!)
JWT_SECRET_KEY=dev-secret-key-please-change-in-production

# JWT token expiration in hours
JWT_EXPIRATION_HOURS=24

# ── macOS: Ollama chạy native (brew install ollama + ollama serve) ──────────
# Bỏ comment 2 dòng dưới, comment service `ollama` trong docker-compose.yml
# OLLAMA_URL=http://host.docker.internal:11434/v1/chat/completions

# ── Nếu muốn dùng model lớn hơn trên prod ──────────────────────────────────
# OLLAMA_MODEL=qwen2.5:7b
